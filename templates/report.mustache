{{!
    @template mod_videoplaylist/report

    Example context (json):
    {
        Aqui tem que criar o context em inglês
    }
}}
<div>
    <div class="d-flex justify-content-between align-items-center mb-3"><h2>{{#str}}
        reporttitle, videoplaylist{{/str}} — {{name}}</h2><a class="btn btn-secondary" href="{{{backurl}}}">{{#str}}
        back, videoplaylist{{/str}}</a></div>
    <div class="table-responsive">
        <table class="table table-striped table-bordered">
            <thead>
            <tr>
                <th>{{#str}}student, videoplaylist{{/str}}</th>{{#videos}}
                <th>{{title}}<br><small>≥ {{minpercent}}%</small></th>{{/videos}}
                <th>{{#str}}overallprogress, videoplaylist{{/str}}</th>
            </tr>
            </thead>
            <tbody>
            {{#students}}
                <tr>
                    <td>{{fullname}}<br><small>{{email}}</small></td>{{#videos}}
                    <td>{{percent}}% {{#completed}}✓{{/completed}}</td>{{/videos}}
                    <td><strong>{{overall}}%</strong></td>
                </tr>{{/students}}
            </tbody>
        </table>
    </div>
</div>
