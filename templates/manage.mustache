{{!
    @template mod_videoplaylist/manage

    Example context (json):
    {
        Aqui tem que criar o context em inglês
    }
}}
<div>
    <div class="d-flex justify-content-between align-items-center mb-3"><h2>{{#str}}
        managevideos, videoplaylist{{/str}} — {{name}}</h2>
        <div><a class="btn btn-primary" href="{{{addurl}}}">{{#str}}addvideo, videoplaylist{{/str}}</a> <a
                class="btn btn-secondary" href="{{{backurl}}}">{{#str}}back, videoplaylist{{/str}}</a></div>
    </div>
    <table class="table table-striped">
        <thead>
        <tr>
            <th>{{#str}}videotitle, videoplaylist{{/str}}</th>
            <th>{{#str}}videosource, videoplaylist{{/str}}</th>
            <th>{{#str}}minpercent, videoplaylist{{/str}}</th>
            <th>{{#str}}enabled, videoplaylist{{/str}}</th>
            <th>{{#str}}actions, videoplaylist{{/str}}</th>
        </tr>
        </thead>
        <tbody>
        {{#videos}}
            <tr>
                <td>{{title}}</td>
                <td>{{source}}</td>
                <td>{{minpercent}}%</td>
                <td>{{#enabled}}{{#str}}yes{{/str}}{{/enabled}}{{^enabled}}{{#str}}no{{/str}}{{/enabled}}</td>
                <td><a href="{{{editurl}}}">{{#str}}edit{{/str}}</a> · <a href="{{{upurl}}}">↑</a> · <a
                        href="{{{downurl}}}">↓</a> · <a href="{{{deleteurl}}}">{{#str}}delete{{/str}}</a></td>
            </tr>{{/videos}}
        </tbody>
    </table>
</div>
